/**
 * Cloudflare Workers Configuration for LINE Cleaning Attendance
 * (データベース不要・Googleスプレッドシートダイレクト反映版)
 * 
 * 【セキュリティ注意】
 * APIキー、シークレット、IDなどの機密情報は絶対にこのファイルに直書きしないでください。
 * シークレットはローカルでは `.dev.vars`、本番では `wrangler secret put <NAME>` で管理します。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-cleaning-attendance",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // 公開しても安全な環境変数
  "vars": {
    "TZ": "Asia/Tokyo"
  }
}
