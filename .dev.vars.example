# ==============================================================================
# ローカル開発用環境変数サンプルファイル (.dev.vars.example)
#
# 【重要・セキュリティ注意事項】
# このファイルは公開リポジトリ用のテンプレートです。
# 実際の設定値は `.dev.vars` にコピーして入力してください。
# `.dev.vars` は .gitignore に含まれており、絶対にコミットしないでください。
# 本番環境（Cloudflare Workers）では `npx wrangler secret put <変数名>` を使用して設定します。
# ==============================================================================

# 1. LINE Messaging API の Channel Secret（必須: Webhook署名検証用）
# LINE Developers コンソール > チャネル基本設定 > Channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 2. LINE Messaging API の Channel Access Token（任意・推奨: 表示名取得用）
# LINE Developers コンソール > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# 3. 許可するLINEグループID（任意だが推奨: 許可したグループ外からのメッセージを無視）
# 例: c1234567890abcdef...
ALLOWED_LINE_GROUP_ID=

# 4. Google Apps Script (GAS) Webhook URL（スプレッドシートへのダイレクト書き込み用）
# 例: https://script.google.com/macros/s/AKfycbx.../exec
SHEETS_WEBHOOK_URL=

# 5. GAS 認証用共有シークレットトークン（任意だが推奨: GAS側API_SECRETと一致させる）
SHEETS_API_SECRET=your_custom_sheets_api_secret

# 6. 論理タイムゾーン（デフォルト: Asia/Tokyo）
TZ=Asia/Tokyo
